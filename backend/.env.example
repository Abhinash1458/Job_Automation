# --- Backend (SaaS) settings ---
# Database. Defaults to a local SQLite file so it runs with zero setup.
# For hosted Postgres, use e.g.:
#   DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/jobhunt
DATABASE_URL=sqlite:///./jobhunt.db

# JWT signing. CHANGE THIS in production (any long random string).
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# CORS: comma-separated origins allowed to call the API (the frontend).
CORS_ORIGINS=http://localhost:3000

# Where uploaded CVs are stored (per user).
UPLOAD_DIR=./uploads

# --- Phase 3 ---
# Worker queue. Leave blank to run match jobs in-process (dev). Set to a Redis
# URL to dispatch to an RQ worker (run `python worker.py` alongside the API).
REDIS_URL=

# Billing (Razorpay, India-first). Leave blank to run billing in MOCK mode —
# the tier/upgrade/limit flow works end-to-end without a live gateway.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Per-user scheduled daily runs (Pro feature).
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=15

# --- LLM + scraping keys ---
# These are read from the PROJECT ROOT .env by the existing src/ modules
# (GROQ_API_KEY / ANTHROPIC_API_KEY, ADZUNA_*, APIFY_TOKEN, etc.).
# You do NOT need to duplicate them here.
